NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Public site URL (https://...) — used for Open Graph metadataBase, Supabase email confirmation redirects, and Server Actions origin checks. Required for custom domains; on Vercel you can omit it to default to https://VERCEL_URL.
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Optional comma-separated extra hosts allowed to invoke Server Actions (host:port or hostname only), e.g. alternate preview domains.
# SERVER_ACTION_ALLOWED_ORIGINS=127.0.0.1:3000,another-host.example.com
NEXT_PUBLIC_APP_URL=https://your-production-domain.com
